# App bind address — which host interface/port the server is reachable on.
# Read by `make run` (bare-metal: passed to `uvicorn --host/--port`) and by docker-compose's own
# "${APP_HOST}:${APP_PORT}:8000" port mapping. Does NOT affect what the app's Settings/DATABASE_URL
# use — see DB_HOST below for that. Unset = defaults to 127.0.0.1:8000.
APP_HOST=127.0.0.1
APP_PORT=8000

# Backend
# Standard PostgreSQL port 5432. Use DB_HOST=db inside Docker Compose, or DB_HOST=localhost on host machine.
DATABASE_URL=postgresql+asyncpg://kpinder:kpinder@localhost:5432/kpinder
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]

DB_HOST=localhost

# Cloudflare R2 (photo upload — POST /auth/upload_photo returns 503 until all four are set)
# Bucket stays private; photo_url in API responses is a short-lived presigned GET URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PRESIGNED_URL_TTL_SECONDS=3600
